app {
    name = "GazaPay"
    version = "1.0.0"
    debug = true

    server {
        host = "0.0.0.0"
        port = 8080
    }

    database {
        driver = "mysql"
        host = "localhost"
        port = 3306
        database = "gazapay"
        username = env("DB_USERNAME", "root")
        password = env("DB_PASSWORD", "secret")
    }
}
